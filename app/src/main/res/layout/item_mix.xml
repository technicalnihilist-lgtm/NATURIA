<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_soft"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@string/mix"
        android:padding="10dp"
        android:src="@drawable/ic_mix" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mix_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mix_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mix_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="@string/play"
        android:padding="9dp"
        android:src="@drawable/ic_play_dark" />

    <ImageView
        android:id="@+id/mix_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/close"
        android:padding="8dp"
        android:src="@drawable/ic_close" />
</LinearLayout>
