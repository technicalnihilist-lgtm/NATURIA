<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ImageView
        android:id="@+id/player_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/home"
                android:padding="10dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="NOW PLAYING"
                android:textColor="#CCEAF7EF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btn_favorite"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/favorites"
                android:padding="10dp"
                android:src="@drawable/ic_heart" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/player_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCD9EDE2"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/player_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:max="1000"
            android:progressDrawable="@drawable/bg_slider"
            android:thumb="@android:color/transparent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#99EAF7EF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/player_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:00"
                android:textColor="#99EAF7EF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_repeat"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/play"
                android:padding="11dp"
                android:src="@drawable/ic_repeat" />

            <ImageView
                android:id="@+id/btn_sleep"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/sleep_timer"
                android:padding="11dp"
                android:src="@drawable/ic_timer" />

            <ImageView
                android:id="@+id/btn_play"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="@string/play"
                android:padding="20dp"
                android:src="@drawable/ic_play_dark" />

            <ImageView
                android:id="@+id/btn_add_mix"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/add_to_mix"
                android:padding="11dp"
                android:src="@drawable/ic_mix" />

            <ImageView
                android:id="@+id/btn_download"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="@string/download"
                android:padding="11dp"
                android:src="@drawable/ic_download" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/mix"
                android:src="@drawable/ic_volume" />

            <SeekBar
                android:id="@+id/player_volume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bg_slider"
                android:thumbTint="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_license"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#99EAF7EF"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
