<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_mini"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/mini_thumb"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_thumb"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mini_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mini_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_primary"
        android:contentDescription="@string/play"
        android:padding="9dp"
        android:src="@drawable/ic_play_dark" />

    <ImageView
        android:id="@+id/mini_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/pause"
        android:padding="9dp"
        android:src="@drawable/ic_close" />
</LinearLayout>
