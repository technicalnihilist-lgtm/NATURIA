<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="26dp"
    android:paddingEnd="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Text.Display"
        android:text="@string/library" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_fav"
            style="@style/LibTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/favorites" />

        <TextView
            android:id="@+id/tab_recent"
            style="@style/LibTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="Recent" />

        <TextView
            android:id="@+id/tab_downloads"
            style="@style/LibTab"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="@string/downloads" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_library"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tv_lib_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Nothing here yet."
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
